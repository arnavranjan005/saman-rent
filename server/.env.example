# Copy to `.env` and fill in real values. Never commit `.env`.
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1

# Neon / Supabase Postgres (pooled + direct). Phase 1 works with
# placeholders — /api/v1/health then reports db: "not-configured".
DATABASE_URL=postgresql://user:password@placeholder-host:5432/samanrent?sslmode=require
DIRECT_URL=postgresql://user:password@placeholder-host:5432/samanrent?sslmode=require

# Auth (Phase 3). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-before-phase-3

# Cloudinary (Phase 4). Secret stays on the server — never commit `.env`.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase phone auth (customer login via POST /auth/firebase).
# Service-account fields from Firebase console → Project settings →
# Service accounts. The private key stays server-side — never commit `.env`.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Phase 10 admin bootstrap (prisma/seed-admin.ts reads these; never commit `.env`).
ADMIN_EMAIL=
ADMIN_PASSWORD=
