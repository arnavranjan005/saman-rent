# Copy to `.env` and fill in real values. Never commit `.env`.
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1

# Neon / Supabase Postgres (pooled + direct). Phase 1 works with
# placeholders — /api/v1/health then reports db: "not-configured".
DATABASE_URL=postgresql://user:password@placeholder-host:5432/samanrent?sslmode=require
DIRECT_URL=postgresql://user:password@placeholder-host:5432/samanrent?sslmode=require

# Auth (Phase 3). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-before-phase-3
