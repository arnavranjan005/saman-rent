{
  "expo": {
    "name": "SamanRent",
    "slug": "samanrent",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "samanrent",
    "primaryColor": "#5B2DF0",
    "android": {
      "package": "com.samanrent.app",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-asset",
      "expo-status-bar",
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SamanRent uses your location to save event addresses to your address book."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth"
    ]
  }
}
